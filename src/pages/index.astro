---
import Layout2025 from '../layouts/Layout2025.astro';

const stack = [
  { name: 'Astro', role: 'Static site generation, routing, content collections' },
  { name: 'Vue', role: 'Interactive islands: comments, book feed, submission form' },
  { name: 'Tailwind CSS + daisyUI', role: 'Styling and component primitives' },
  { name: 'Supabase', role: 'Postgres database, authentication, row-level auth' },
  { name: 'Netlify', role: 'Hosting, SSR functions, scheduled rebuilds' },
];

const features = [
  {
    title: 'Per-year content collections',
    body: "Books and competitors were modeled as Astro content collections, one set per year (2024, 2025, 2026), all validated against two shared Zod schemas (concorrentiSchema, librosSchema). New reading years could be added by dropping in a new folder of markdown files.",
    image: '/case-study/books-list-2024.jpg',
    alt: '2024 books grid listing every book read that year with author, tags and points',
  },
  {
    title: 'A friendly points & ranking system',
    body: "Each book earned points depending on type (book vs. comic) and length, with bonus points for longer reads. The logic lived in a small calculatePoints() helper, aggregated per competitor to drive the yearly leaderboard.",
    image: '/case-study/year-2026.jpg',
    alt: '2026 competition page showing a top-3 leaderboard of competitors',
  },
  {
    title: 'Supabase authentication',
    body: 'A two-table system — Supabase-managed auth.users plus an app-owned profiles table, linked by a database trigger that auto-created a profile row on signup — backed sign up, sign in, and session-aware pages.',
    image: '/case-study/login.jpg',
    alt: 'Sign in form for the reading club',
  },
  {
    title: 'Book submission & comments',
    body: 'Signed-in members could submit new books through a Vue form and leave comments on any book, both talking to Astro API routes that used a server-side Supabase client so the service-role key never reached the browser.',
    image: '/case-study/submit-form.jpg',
    alt: 'Submit a book form gated behind sign-in',
  },
  {
    title: 'Bilingual route trees',
    body: 'Basque and Spanish readers got their own parallel route trees (lehiakideak/liburuak vs. concorrenti/libros) sharing the same underlying content and layouts — a real-world case of i18n via folder structure rather than a formal i18n library.',
    image: '/case-study/competitors-2025.jpg',
    alt: 'Competitors page listing each participant with a short bio, in Basque',
  },
  {
    title: 'The team behind it',
    body: "Eight friends, eight avatars, one shared spreadsheet-turned-web-app. What began as a way to track who was reading the most in 2024 grew into a small full-stack project with real users, real data, and real bugs.",
    image: '/case-study/team-page.jpg',
    alt: 'Team page with illustrated avatars for each competitor',
  },
];
---

<Layout2025 title='Irakurketa Lehiaketa — Case Study'>
  <div class='min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-900'>
    <!-- Hero -->
    <header class='relative overflow-hidden'>
      <div
        class='absolute inset-0 bg-gradient-to-r from-basque-10/20 to-basque-20/20 backdrop-blur-3xl'>
      </div>
      <div class='relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32 text-center'>
        <div class='inline-block mb-6 relative'>
          <div class='absolute inset-0 bg-gradient-to-r from-basque-10 to-basque-20 blur-3xl opacity-30'>
          </div>
          <h1 class='relative text-4xl md:text-6xl font-black text-white mb-4 tracking-tight'>
            <span class='bg-gradient-to-r from-basque-10 via-basque-20 to-basque-10 bg-clip-text text-transparent'>
              Irakurketa Lehiaketa
            </span>
          </h1>
        </div>
        <p class='text-xl md:text-2xl text-gray-300 mb-4 font-light'>
          A reading competition, built as a full-stack side project
        </p>
        <p class='text-base md:text-lg text-gray-400 max-w-2xl mx-auto'>
          A case study of a bilingual (Spanish/Basque) app I built and ran for a
          group of friends across three reading years — 2024 through 2026 — since
          retired. Static site now, but here's what shipped while it was live.
        </p>
      </div>
    </header>

    <main class='max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24'>
      <!-- Context -->
      <section>
        <div class='bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md rounded-3xl p-8 md:p-12 border border-white/20 shadow-2xl'>
          <h2 class='text-2xl md:text-3xl font-bold text-white mb-6'>
            The problem
          </h2>
          <p class='text-lg text-gray-300 leading-relaxed mb-4'>
            A group of friends wanted a friendly way to compete on how much they
            read each year — more than a shared spreadsheet, less than a
            full-blown Goodreads clone. I built and maintained the site that ran
            this competition from 2024 onward: tracking books, scoring points,
            ranking competitors, and giving everyone a place to see what everyone
            else was reading.
          </p>
          <p class='text-lg text-gray-300 leading-relaxed'>
            The homepage below is what greeted returning readers each year — a
            live look at three competitions and running totals across them.
          </p>
        </div>
        <img
          src='/case-study/homepage.jpg'
          alt='Original homepage with a hero, community intro, and a year-by-year timeline'
          class='mt-8 rounded-2xl border border-white/10 shadow-2xl w-full'
        />
      </section>

      <!-- Tech stack -->
      <section>
        <h2 class='text-2xl md:text-3xl font-bold text-white mb-8 text-center'>
          Tech stack
        </h2>
        <div class='grid sm:grid-cols-2 gap-4'>
          {
            stack.map(item => (
              <div class='bg-white/5 rounded-2xl p-6 border border-white/10 hover:border-basque-10/30 transition-all'>
                <h3 class='text-lg font-bold text-white mb-1'>{item.name}</h3>
                <p class='text-sm text-gray-400'>{item.role}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Features -->
      <section>
        <h2 class='text-2xl md:text-3xl font-bold text-white mb-12 text-center'>
          What I built
        </h2>
        <div class='space-y-16'>
          {
            features.map((feature, i) => (
              <div
                class={`grid md:grid-cols-2 gap-8 items-center ${
                  i % 2 === 1 ? 'md:[direction:rtl]' : ''
                }`}>
                <div class='md:[direction:ltr]'>
                  <h3 class='text-xl md:text-2xl font-bold text-white mb-3'>
                    {feature.title}
                  </h3>
                  <p class='text-gray-300 leading-relaxed'>{feature.body}</p>
                </div>
                <img
                  src={feature.image}
                  alt={feature.alt}
                  class='md:[direction:ltr] rounded-2xl border border-white/10 shadow-xl w-full'
                  loading='lazy'
                />
              </div>
            ))
          }
        </div>
      </section>

      <!-- Lessons learned -->
      <section>
        <div class='bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md rounded-3xl p-8 md:p-12 border border-white/20 shadow-2xl'>
          <h2 class='text-2xl md:text-3xl font-bold text-white mb-6'>
            Lessons learned
          </h2>
          <ul class='space-y-4 text-gray-300 leading-relaxed list-disc list-inside'>
            <li>
              Reusing one Zod schema across six content collections (one per
              year, per language) was DRY on paper, but it let a real bug slip
              through: two of those collections ended up aliasing the exact same
              underlying schema objects instead of pointing at distinct content,
              and a page kept querying a collection whose folder didn't actually
              exist. It never crashed the build — Astro just silently returned an
              empty set — which is precisely the kind of failure that's easy to
              miss without type-level guarantees tying collection names to
              folders.
            </li>
            <li>
              I'd model this as a single collection with a <code>year</code> field
              instead of duplicating collections per year — same validation,
              fewer places for a foldername/collection-name mismatch to hide.
            </li>
            <li>
              The point-scoring logic lived in a small client-side JS module. A
              Postgres view or function would have kept scoring consistent
              regardless of which part of the app read it.
            </li>
            <li>
              Migrating this from a live SSR + Supabase app to a fully static
              case study was itself a good exercise: stripping auth, API routes,
              and dynamic content down to what's actually worth showing.
            </li>
          </ul>
        </div>
      </section>

      <!-- Closing CTA -->
      <section class='text-center'>
        <div class='inline-block bg-gradient-to-r from-basque-10 to-basque-20 rounded-2xl p-8 md:p-12 shadow-2xl'>
          <h3 class='text-2xl md:text-3xl font-bold text-white mb-4'>
            Want to see the code?
          </h3>
          <p class='text-gray-100 mb-6 max-w-2xl'>
            The full source, including the content collections and Supabase
            integration described above, is on GitHub.
          </p>
          <a
            href='https://github.com/alessandro-giuzio'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center px-8 py-4 bg-white text-basque-10 font-bold rounded-xl hover:bg-gray-100 transition-all hover:scale-105 shadow-lg'>
            View on GitHub
          </a>
        </div>
      </section>
    </main>
  </div>

  <style>
    html {
      scroll-behavior: smooth;
    }
  </style>
</Layout2025>
