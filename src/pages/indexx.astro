---
import Layout2026 from '../layouts/Layout2026.astro';
import Button from '@/components/ui/button/Button.vue';
import BookFeed from '../components/book/BookFeed.vue';
---

<Layout2026 title='Irakurketa 2025' socialImage='/okBooks.webp'>
  <nav
    class='bg-chart-5 text-white flex items-center justify-between px-4 py-6 mb-8'>
    <div class='flex flex-col items-start space-y-2 ml-8'>
      <span class='text-3xl font-bold'>The Book Club</span>
      <p class='text-lg text-chart-1'>Lorem ipsum dolor sit amet.</p>
    </div>
    <a
      href='/submit'
      class='rounded-full border border-chart-2 bg-chart-2 px-4 py-2 text-sm font-medium text-white hover:bg-chart-3 hover:text-white'>
      Submit a book
    </a>
  </nav>
  <main>
    <BookFeed client:visible />
  </main>
</Layout2026>
