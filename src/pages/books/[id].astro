---
import Layout2026 from '../../layouts/Layout2026.astro';
import BookComments from '../../components/book/BookComments.vue';
import { supabaseServer } from '../../lib/supabaseServer';

export const prerender = false;

const { id } = Astro.params;
const { data: book, error } = await supabaseServer
  .from('books_with_stats')
  .select('*')
  .eq('id', id)
  .single();

if (error || !book) {
  return new Response('Book not found', { status: 404 });
}
---

<Layout2026 title={book.title ?? 'Book'}>
  <main class="mx-auto max-w-4xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-[220px_1fr]">
      <div class="aspect-[3/4] overflow-hidden rounded-2xl bg-gray-100">
        <img
          src={book.cover_url || '/no-cover.png'}
          alt={book.title}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="space-y-4">
        <div>
          <p class="text-sm text-gray-500">Added by {book.creator_name}</p>
          <h1 class="text-3xl font-semibold text-gray-900">{book.title}</h1>
          <p class="text-lg text-gray-600">by {book.author}</p>
        </div>
        {book.summary && <p class="text-gray-700">{book.summary}</p>}
        {book.tags?.length && (
          <div class="flex flex-wrap gap-2">
            {book.tags.map((tag: string) => (
              <span class="rounded-full bg-gray-100 px-2 py-1 text-xs text-gray-600">
                {tag}
              </span>
            ))}
          </div>
        )}
        <div class="flex gap-4 text-sm text-gray-500">
          <span>{book.like_count ?? 0} likes</span>
          <span>{book.comment_count ?? 0} comments</span>
        </div>
      </div>
    </div>

    <BookComments client:visible bookId={book.id} />
  </main>
</Layout2026>
